[Desktop Entry]
Type=Application
Name=Roozlet
Name[fa]=روزلت
GenericName=Persian Calendar
GenericName[fa]=تقویم فارسی
Comment=Offline Persian, Gregorian and Iranian Hijri calendar
Comment[fa]=تقویم آفلاین شمسی، میلادی و قمری ایران
Exec=rooz
TryExec=rooz
Icon=rooz
Terminal=false
Categories=Office;Calendar;
Keywords=Persian;Jalali;Iran;Calendar;
StartupNotify=false
StartupWMClass=Rooz
Actions=Calendar;Search;Personal;Settings;

[Desktop Action Search]
Name=Search dates and occasions
Name[fa]=جستجوی تاریخ و مناسبت
Exec=rooz --search

[Desktop Action Personal]
Name=Notes and reminders
Name[fa]=یادداشت و یادآور
Exec=rooz --personal

[Desktop Action Calendar]
Name=Open calendar
Name[fa]=باز کردن تقویم
Exec=rooz --calendar

[Desktop Action Settings]
Name=Settings
Name[fa]=تنظیمات
Exec=rooz --settings
